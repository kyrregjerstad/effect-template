{
  "name": "effect-template",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@effect/vitest": "0.29.0",
      "@types/bun": "1.3.14",
      "effect": "3.21.4",
      "lefthook": "2.1.9",
      "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
      "vite-plus": "0.1.24",
      "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
    }
  },
  "type": "module",
  "scripts": {
    "check": "vp check && vp test run",
    "examples:sync": "bun scripts/sync-examples.ts",
    "format": "vp fmt --write",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "prepare": "vp config",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "typecheck": "vp check --no-fmt --no-lint"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "lefthook": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  },
  "packageManager": "bun@1.3.14"
}
