{
  "name": "effect-template",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@effect/vitest": "0.29.0",
      "@types/bun": "1.3.13",
      "effect": "3.21.2",
      "lefthook": "2.1.6",
      "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
      "vite-plus": "0.1.24",
      "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
    }
  },
  "type": "module",
  "scripts": {
    "check": "vp check && vp test",
    "examples:sync": "bun scripts/sync-examples.ts",
    "format": "vp fmt --write",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "test": "vp test",
    "test:watch": "vp test watch",
    "typecheck": "vp check --no-fmt --no-lint"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "lefthook": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
